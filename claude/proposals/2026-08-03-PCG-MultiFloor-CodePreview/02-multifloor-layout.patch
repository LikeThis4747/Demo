+	IMPLEMENT_SIMPLE_AUTOMATION_TEST(
+		FZeroEscapeOptionalStairOrderAndHighRoomDistanceTest,
+		"Demo.PCG.Unit.MultiFloor.OptionalStairOrderAndHighRoomDistance",
+		EAutomationTestFlags_ApplicationContextMask
+			| EAutomationTestFlags::ProductFilter)
+
+	bool FZeroEscapeOptionalStairOrderAndHighRoomDistanceTest::RunTest(
+		const FString& Parameters)
+	{
+		(void)Parameters;
+		const TArray<int32> TwoPerPair = { 2, 2, 2 };
+		TArray<int32> FirstOrder;
+		TestTrue(TEXT("四层额外楼梯楼层对顺序必须可解析"),
+			FMultiFloorLayoutPlanner::BuildAdditionalStairPairOrderForTesting(
+				240813,
+				GAlgorithmVersion,
+				4,
+				0,
+				TwoPerPair,
+				FirstOrder));
+		TestEqual(TEXT("三对楼层各目标两座时必须产生六次公平尝试"),
+			FirstOrder.Num(), 6);
+		for (int32 Round = 0; Round < 2; ++Round)
+		{
+			TSet<int32> PairSet;
+			for (int32 Index = 0; Index < 3 && FirstOrder.IsValidIndex(Round * 3 + Index);
+				++Index)
+			{
+				PairSet.Add(FirstOrder[Round * 3 + Index]);
+			}
+			TestEqual(TEXT("每轮必须先让每个相邻楼层对各获得一次机会"),
+				PairSet.Num(), 3);
+			TestTrue(TEXT("每轮必须覆盖 1-2、2-3、3-4 三个楼层对"),
+				PairSet.Contains(0)
+					&& PairSet.Contains(1)
+					&& PairSet.Contains(2));
+		}
+
+		TArray<int32> ReplayOrder;
+		TestTrue(TEXT("同 Seed 的楼层对顺序必须可重放"),
+			FMultiFloorLayoutPlanner::BuildAdditionalStairPairOrderForTesting(
+				240813,
+				GAlgorithmVersion,
+				4,
+				0,
+				TwoPerPair,
+				ReplayOrder));
+		TestTrue(TEXT("同 Seed、尝试号和目标必须得到完全相同的轮转顺序"),
+			FirstOrder == ReplayOrder);
+
+		TSet<int32> FirstPairAcrossSeeds;
+		for (int32 Seed = 0; Seed < 96; ++Seed)
+		{
+			TArray<int32> SeedOrder;
+			if (FMultiFloorLayoutPlanner::BuildAdditionalStairPairOrderForTesting(
+					Seed,
+					GAlgorithmVersion,
+					4,
+					0,
+					TwoPerPair,
+					SeedOrder)
+				&& !SeedOrder.IsEmpty())
+			{
+				FirstPairAcrossSeeds.Add(SeedOrder[0]);
+			}
+		}
+		TestEqual(TEXT("不同 Seed 的第一优先楼层对不得固定偏向低层"),
+			FirstPairAcrossSeeds.Num(), 3);
+
+		const TArray<FIntVector> FirstRoom = {
+			FIntVector(0, 0, 0), FIntVector(1, 0, 0) };
+		const TArray<FIntVector> SecondRoom = {
+			FIntVector(3, 0, 0), FIntVector(4, 0, 0) };
+		TestEqual(
+			TEXT("1x2 房间间距必须取两个 Walkable footprint 的最近格而非 Base"),
+			FMultiFloorLayoutPlanner::
+				ComputeWalkableFootprintDistanceSquaredForTesting(
+					FirstRoom,
+					SecondRoom),
+			4.0);
+		const TArray<FIntVector> OtherFloorRoom = {
+			FIntVector(3, 0, 1), FIntVector(4, 0, 1) };
+		TestEqual(TEXT("没有同层 footprint 对时不得伪造二维房间间距"),
+			FMultiFloorLayoutPlanner::
+				ComputeWalkableFootprintDistanceSquaredForTesting(
+					FirstRoom,
+					OtherFloorRoom),
+			-1.0);
+		return true;
+	}
