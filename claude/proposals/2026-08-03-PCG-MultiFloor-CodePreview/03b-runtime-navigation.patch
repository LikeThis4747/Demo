+	{
+		return FailReport(
+			InOutReport,
+			EZeroEscapeGenerationStage::NavigationBuild,
+			EZeroEscapeGenerationFailure::NavigationValidationFailed,
+			INDEX_NONE,
+			TEXT("正式 NavigationSystem 或 GeneratedRoot 不可用。"));
