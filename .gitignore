# Unreal generated
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vs/
*.sln

# Local Python environments/caches
**/.venv/
**/__pycache__/
*.pyc

# AI workspace: task cards and handoffs are intentionally versioned.
# Only disposable scratch/output is ignored.
claude/scratch/*
!claude/scratch/.gitkeep
claude/artifacts/*
!claude/artifacts/.gitkeep
!claude/artifacts/nightly/
!claude/artifacts/nightly/*.md

# Local AI audit/runtime files
.ai-memory/events.jsonl
.ai-memory/backups/
.ai-memory/temp/
